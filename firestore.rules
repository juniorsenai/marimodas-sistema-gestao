rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Apenas usuários autenticados têm acesso ao sistema.
    // Usuários não logados são completamente bloqueados.
    // ============================================================

    // Dados dos produtos (estoque)
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Dados de vendas realizadas
    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }

    // Perfis dos usuários do sistema
    match /users/{userId} {
      // Usuários podem ler e escrever apenas o seu próprio perfil
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bloquear qualquer outra coleção não mapeada acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
